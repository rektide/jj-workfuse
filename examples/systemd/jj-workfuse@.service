# System-scope instance template: one jj-workfuse mount per instance name.
#
# Install as /etc/systemd/system/jj-workfuse@.service and configure each
# instance through /etc/jj-workfuse/<name>.conf, then
#   systemctl enable --now jj-workfuse@<name>
# See examples/systemd/README.md for the variable reference.

[Unit]
Description=jj-workfuse read-only mount (%i)
Documentation=file:/usr/share/doc/jj-workfuse/README.md
# Order after the storage holding the source repository, e.g. for /home:
# RequiresMountsFor=/home

[Service]
Type=notify
EnvironmentFile=/etc/jj-workfuse/%i.conf
ExecStart=/usr/local/bin/jj-workfuse mount
# Sweep a disconnected mount left by SIGKILL; "-" ignores "not mounted".
ExecStopPost=-/usr/bin/fusermount3 -u ${JJ_WORKFUSE_MOUNTPOINT}
Restart=on-failure
RestartSec=2s
# Do not add PrivateTmp/PrivateMounts/ProtectSystem here: the service must
# stay in the host mount namespace or the mount becomes unit-private.

[Install]
WantedBy=multi-user.target
